{
  "name": "erpnext-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "6ab1676aa1f9415fbaa0fde02d2f5e50"
    }
  ],
  "keep_vars": true,
  "vars": {
    "ERP_BASE_URL": "https://erp.erchms.com",
    "GITHUB_ALLOWED_USER_ID": "10105528"
  }
}
